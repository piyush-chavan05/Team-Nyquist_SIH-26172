# sdkconfig.defaults — ESP32-S3 firmware default configuration
# These settings are applied during 'idf.py build' before sdkconfig is generated.
# Override in sdkconfig for board-specific settings.

# ── Target ───────────────────────────────────────────
CONFIG_IDF_TARGET="esp32s3"

# ── CPU frequency ─────────────────────────────────────
# Use 240 MHz for maximum performance during KWS inference
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y

# ── FreeRTOS ─────────────────────────────────────────
# Tick rate: 1 kHz for precise task timing
CONFIG_FREERTOS_HZ=1000

# ── Memory ───────────────────────────────────────────
# Enable PSRAM if board supports it (optional — not required for prototype)
# CONFIG_ESP32S3_SPIRAM_SUPPORT=y
# CONFIG_SPIRAM_MODE_OCT=y

# ── Wi-Fi ─────────────────────────────────────────────
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# ── Logging ───────────────────────────────────────────
# Default log level: INFO
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ── Stack sizes ───────────────────────────────────────
# Main task stack: 8 KB
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ── I2S / Audio ───────────────────────────────────────
# I2S driver enabled (required for digital MEMS microphone)
CONFIG_SOC_I2S_SUPPORTED=y

# ── Partition table ───────────────────────────────────
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
