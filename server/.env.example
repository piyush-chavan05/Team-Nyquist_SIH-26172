# Environment variables for ASR server
# Copy this file to .env and fill in values
# NEVER commit .env to the repository

# Server bind settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ASR backend: stub | vosk | whisper | faster_whisper
ASR_BACKEND=stub

# Model path (backend-specific)
# For Vosk: path to extracted model directory
# For Whisper/FasterWhisper: model name (base, small, medium)
ASR_MODEL_PATH=

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
